LEOMINAL_HOST=127.0.0.1
LEOMINAL_PORT=3107
LEOMINAL_WORKSPACE_ROOT=
LEOMINAL_SHELL=
LEOMINAL_STATE_PATH=.leominal/state.json
LEOMINAL_SESSION_SECRET=replace-with-generate-secrets-output
LEOMINAL_SESSION_TTL_SECONDS=43200
LEOMINAL_COOKIE_SECURE=false
LEOMINAL_ALLOWED_ORIGINS=http://127.0.0.1:3107,http://localhost:3107
LEOMINAL_PID_PATH=.leominal/leominal.pid
LEOMINAL_LOG_PATH=.leominal/leominal.log
LEOMINAL_HEALTH_TIMEOUT_SECONDS=15
LEOMINAL_STOP_TIMEOUT_SECONDS=20
